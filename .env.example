# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Path to your MT5 terminal (research PC), used for data export and demo runs
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Demo account only on the research PC. Live logins never go here.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
# git push from the worker uses your normal git credentials (Git Credential Manager)
